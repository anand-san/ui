{
  "name": "san-ui-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "bun run build:storybook && bun run build:registry && bun run build:docs",
    "build:storybook": "storybook build -o dist --quiet",
    "build:registry": "bun scripts/build-registry.ts && shadcn build registry.json --output dist/r",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "prettier --check . && bun scripts/build-docs.ts --check",
    "format": "prettier --write .",
    "build:docs": "bun scripts/build-docs.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "3.6.0",
    "lucide-react": "^0.530.0",
    "react": "^18.3.1",
    "react-day-picker": "8.10.1",
    "react-dom": "^18.3.1",
    "sonner": "2.0.7",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@sandilya/ui": "workspace:*",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-themes": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "latest",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "prettier": "3.8.3",
    "shadcn": "4.23.0",
    "storybook": "10.6.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.0.6"
  }
}
